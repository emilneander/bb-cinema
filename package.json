{
  "name": "our-cinema",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun scripts/run.ts dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun scripts/run.ts start",
    "typecheck": "tsc --noEmit && bun run --cwd apps/web typecheck",
    "test": "bun test tests",
    "test:e2e": "playwright test",
    "db:migrate": "bun scripts/manage.ts migrate",
    "db:backup": "bun scripts/manage.ts backup",
    "invite": "bun scripts/manage.ts invite",
    "check:jellyfin": "bun scripts/manage.ts jellyfin",
    "check:tmdb": "bun scripts/manage.ts tmdb",
    "tailscale:serve": "bash scripts/tailscale-serve.sh",
    "tailscale:check": "tailscale serve status",
    "awake": "caffeinate -dimsu",
    "launchagent": "bun scripts/launchagent.ts",
    "format": "prettier --write apps packages scripts tests e2e docs README.md package.json playwright.config.ts tsconfig.json",
    "format:check": "prettier --check apps packages scripts tests e2e docs README.md package.json playwright.config.ts tsconfig.json",
    "funnel:check": "bun scripts/funnel.ts check",
    "funnel:start": "bun scripts/funnel.ts start",
    "funnel:stop": "bun scripts/funnel.ts stop",
    "funnel:status": "bun scripts/funnel.ts status",
    "funnel:public-check": "bun scripts/check-public.ts",
    "audit:source": "bun scripts/audit-source.ts",
    "setup": "bun scripts/manage.ts setup",
    "export:source": "bun scripts/export-source.ts"
  },
  "dependencies": {
    "hono": "4.13.7",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/bun": "1.4.1",
    "@playwright/test": "1.63.0",
    "prettier": "3.9.6"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=20.9"
  },
  "license": "MIT"
}
